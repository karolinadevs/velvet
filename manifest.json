{
    "manifest_version": 3,
    "name": "Velvet",
    "version": "1.3.1",
    "description": "A fast, accessible sticky note board right in your toolbar.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Open Notes"
    }
}